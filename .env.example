# ─────────────────────────────────────────────────────────────
# Universo Tendas — variáveis de ambiente
# Copie para .env (local) ou cadastre no painel da Vercel.
# NUNCA faça commit do arquivo .env com valores reais.
# ─────────────────────────────────────────────────────────────

# PostgreSQL (Supabase recomendado).
# Supabase → Project Settings → Database → Connection string:
#   DATABASE_URL: "Transaction pooler" (porta 6543) + ?pgbouncer=true&connection_limit=1
#   DIRECT_URL:   "Direct connection" ou "Session pooler" (porta 5432) — usada pelas migrations.
DATABASE_URL="postgresql://usuario:senha@host:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://usuario:senha@host:5432/postgres"

# Segredo para assinar a sessão de login. Mínimo 32 caracteres aleatórios.
# Gere com: openssl rand -base64 48
AUTH_SECRET=""

# Usadas apenas pelo comando `npm run admin:create` (não precisam ficar salvas).
# ADMIN_EMAIL="voce@exemplo.com"
# ADMIN_PASSWORD="uma-senha-forte-com-10+-caracteres"
# ADMIN_NAME="Seu nome"

# Somente para `npm test` (banco descartável — será APAGADO a cada execução).
# TEST_DATABASE_URL="postgresql://usuario:senha@localhost:5432/universo_tendas_test"

# Endereço público do site (canonical, sitemap.xml e robots.txt). Opcional.
# Sem ela, usa o domínio oficial https://universotendas.app.br
# SITE_URL="https://universotendas.app.br"

# AMBIENTES SEPARADOS — cada um com o SEU banco:
#   desenvolvimento → .env local com DATABASE_URL/DIRECT_URL do banco de DESENVOLVIMENTO
#   teste           → TEST_DATABASE_URL (descartável; testes de concorrência e E2E rodam só aqui)
#   produção        → somente no painel da Vercel (nunca no .env local)
